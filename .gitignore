# Python 가상환경 (재생성 가능, 용량 큼)
venv/
__pycache__/
*.py[cod]
*.egg-info/

# 비밀키 / 환경변수 (절대 공유 금지)
.env
.env.*
*.key

# macOS 시스템 파일
.DS_Store

# 생성된 결과물 (필요하면 이 줄을 지우세요)
outputs/

# 에디터/IDE 설정
.vscode/
.idea/
.claude/

# R 실행 부산물 (실행할 때마다 재생성됨)
Rplots.pdf
.Rapp.history
.Rhistory

# 로컬 전용 문서 (공개 저장소에 올리지 않는다 — 파일은 로컬에 그대로 둔다)
#
# 확장자 패턴(*.pdf, *.svg)을 쓰지 않는다. 나중에 올리고 싶은 다이어그램이나
# 보고서까지 막기 때문이다. 올리지 않을 것만 이름으로 지정하고,
# 공개해도 되는 파일이 생기면 여기 손대지 않아도 커밋된다.

# 개발 계획서 / 내부 기획 메모: 공개 여부를 이 저장소 단독으로 정할 사안이 아니다
루미네선스 연대 해석을 위한 데이터 시각화 및 모델 추천 시스템 개발.pdf
LumiGuide_멀티에이전트_기획정리.txt

# 작업 노트: 내부 논의가 섞여 있다. 날짜별로 계속 생기므로 패턴으로 둔다
전체점검 및 수정*.txt
이슈정리_*.txt

# 코드 구조 다이어그램: 공개해도 무방하지만 지금은 저장소 밖에 둔다.
# 올리려면 아래 두 줄을 지우면 된다.
LumiGuide_코드구조_도식.pdf
LumiGuide_함수흐름도.svg
