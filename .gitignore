# Python 가상환경 (재생성 가능, 용량 큼)
venv/
__pycache__/
*.py[cod]
*.egg-info/

# 비밀키 / 환경변수 (절대 공유 금지)
.env
.env.*
*.key

# macOS 시스템 파일
.DS_Store

# 생성된 결과물 (필요하면 이 줄을 지우세요)
outputs/

# 에디터/IDE 설정
.vscode/
.idea/
.claude/

# R 실행 부산물 (실행할 때마다 재생성됨)
Rplots.pdf
.Rapp.history
.Rhistory

# 기획/작업 문서 (공개 저장소에 올리지 않는다 — 로컬에는 그대로 둔다)
# 개발 계획서와 내부 기획 메모는 이 프로젝트 단독으로 공개를 정할 사안이 아니고,
# 작업 노트에는 내부 논의 내용이 섞여 있다.
*.pdf
*.svg
이슈정리_*.txt
전체점검 및 수정*.txt
LumiGuide_*.txt
